FROM ubuntu:24.04

# Update system and add the packages required for Yocto builds.
# Use DEBIAN_FRONTEND=noninteractive, to avoid image build hang waiting
# for a default confirmation [Y/n] at some configurations.

ENV DEBIAN_FRONTEND=noninteractive
RUN apt update
RUN apt install -y gawk wget git-core diffstat unzip texinfo \
    gcc-multilib build-essential chrpath socat file cpio python3 \
    python3-pip python3-pexpect xz-utils debianutils iputils-ping \
    libsdl1.2-dev xterm tar locales net-tools rsync sudo vim curl zstd \
    liblz4-tool libssl-dev bc lzop libgnutls28-dev efitools git-lfs

# Set up locales
RUN locale-gen en_US.UTF-8 && \
    update-locale LC_ALL=en_US.UTF-8 LANG=en_US.UTF-8
ENV LANG en_US.UTF-8
ENV LC_ALL en_US.UTF-8

# Point Git global config to a persistent file inside the mounted workspace
ENV GIT_CONFIG_GLOBAL=/run/media/arash/Projects/iMX95/imx-docker/.gitconfig

# Yocto needs 'source' command for setting up the build environment, so replace
# the 'sh' alias to 'bash' instead of 'dash'.
RUN rm /bin/sh && ln -s bash /bin/sh

# Install repo
ADD https://storage.googleapis.com/git-repo-downloads/repo /usr/local/bin/
RUN chmod 755 /usr/local/bin/repo

# Add your user to sudoers to be able to install other packages in the container.
ARG USER
RUN echo "${USER} ALL=(ALL) NOPASSWD: ALL" > /etc/sudoers.d/${USER} && \
    chmod 0440 /etc/sudoers.d/${USER}

# Set the arguments for host_id and user_id to be able to save the build artifacts
# outside the container, on host directories, as docker volumes.
ARG host_uid \
    host_gid

# Robust handling for pre-existing GID/UID in the Ubuntu base image
RUN if ! getent group $host_gid > /dev/null 2>&1; then \
        groupadd -g $host_gid nxp; \
    fi && \
    if ! getent passwd $host_uid > /dev/null 2>&1; then \
        useradd -g $host_gid -m -s /bin/bash -u $host_uid $USER; \
    else \
        existing_user=$(getent passwd $host_uid | cut -d: -f1); \
        usermod -l $USER -d /home/$USER -m $existing_user; \
    fi

ARG DOCKER_WORKDIR
WORKDIR ${DOCKER_WORKDIR}

# Copy Yocto helper scripts into the container
COPY yocto-repo-build.sh yocto-launch.sh yocto-bitbake-image.sh /usr/local/bin/
RUN chmod +x /usr/local/bin/yocto-repo-build.sh /usr/local/bin/yocto-launch.sh /usr/local/bin/yocto-bitbake-image.sh

# Yocto builds should run as a normal user.
USER $USER
